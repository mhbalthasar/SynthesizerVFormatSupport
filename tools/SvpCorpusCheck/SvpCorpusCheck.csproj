<Project Sdk="Microsoft.NET.Sdk">

  <!-- 语料校验探针：只编译格式包里「读侧」需要的源文件，批量吃真实 .svp，打印规模、降级清单与导入结果。
       与主工程同一套 SDK 引用口径（宿主 DLL 由 SDKPath 提供，不打进包）。 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SvpCorpusCheck</AssemblyName>
    <RootNamespace>SvpCorpusCheck</RootNamespace>
    <OutputType>Exe</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 与主工程同源：SDK 树位置取 TUNELAB_SDK_ROOT / -p:TuneLabSdkRoot，仓库里不留默认值。 -->
    <TuneLabSdkRoot Condition="'$(TuneLabSdkRoot)' == ''">$(TUNELAB_SDK_ROOT)</TuneLabSdkRoot>
    <TuneLabSdkRoot Condition="'$(TuneLabSdkRoot)' != ''">$([MSBuild]::EnsureTrailingSlash('$(TuneLabSdkRoot)'))</TuneLabSdkRoot>
    <PackageRoot>$(MSBuildThisFileDirectory)..\..\</PackageRoot>
  </PropertyGroup>

  <Target Name="RequireTuneLabSdkRoot" BeforeTargets="ResolveProjectReferences">
    <Error Condition="'$(TuneLabSdkRoot)' == ''"
           Text="未指定 TuneLab SDK 源码树位置。设置环境变量 TUNELAB_SDK_ROOT=&lt;TuneLab2 所在目录&gt;，或加 -p:TuneLabSdkRoot=&lt;路径&gt;。" />
  </Target>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(PackageRoot)src\Model\*.cs" />
    <Compile Include="$(PackageRoot)src\Common\*.cs" />
    <Compile Include="$(PackageRoot)src\Reader\*.cs" />
    <Compile Include="$(PackageRoot)src\Writer\*.cs" />
    <Compile Include="$(PackageRoot)src\Mapping\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 探针是独立 exe，宿主不在旁边 ⇒ SDK 程序集必须拷进输出目录（Private=true）。 -->
    <ProjectReference Include="$(TuneLabSdkRoot)TuneLab.Foundation\TuneLab.Foundation.csproj">
      <Private>true</Private>
    </ProjectReference>
    <ProjectReference Include="$(TuneLabSdkRoot)TuneLab.SDK\TuneLab.SDK.csproj">
      <Private>true</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
